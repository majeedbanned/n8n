{
  "name": "WORKFLOW - Error Handler",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -520,
        240
      ],
      "id": "f7a3e9f2-8f50-4f4e-bb67-errtrigger001",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json || {};\nconst execution = input.execution || {};\nconst workflow = input.workflow || {};\nconst err = input.error || execution.error || {};\nconst failedNode = execution.lastNodeExecuted || input.lastNodeExecuted || null;\n\nlet context = {};\ntry {\n  const runData = execution.data?.resultData?.runData || {};\n  const nodeRuns = runData[failedNode] || [];\n  const first = nodeRuns[0]?.data?.main?.[0]?.[0]?.json;\n  if (first && typeof first === 'object') context = first;\n} catch (e) {}\n\nconst channel = context.channel || context.metadata?.source || null;\nconst sessionId = context.session_id || context.sessionId || context.metadata?.chat_id || null;\nconst userPhone = context.user_phone || context.user_email || context.user_identifier || null;\n\nreturn [{\n  ...context,\n  workflow_id: workflow.id || null,\n  workflow_name: workflow.name || null,\n  execution_id: execution.id || null,\n  failed_node: failedNode,\n  error_message: String(err.message || input.message || 'Unknown workflow error'),\n  error_stack: err.stack ? String(err.stack).slice(0, 4000) : null,\n  channel,\n  session_id: sessionId,\n  user_phone: userPhone,\n  fallback_message: 'Service is temporarily unavailable. Please try again in a moment.',\n  raw_payload: input\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        240
      ],
      "id": "88a8f6f2-0916-4ae6-a9d6-errnormalize001",
      "name": "Normalize Error Context"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_error_logs (\n  workflow_id,\n  workflow_name,\n  execution_id,\n  failed_node,\n  error_message,\n  error_stack,\n  channel,\n  session_id,\n  user_phone,\n  payload,\n  created_at\n)\nVALUES (\n  {{ $json.workflow_id ? (\"'\" + String($json.workflow_id).replace(/'/g, \"''\") + \"'\") : 'NULL' }},\n  {{ $json.workflow_name ? (\"'\" + String($json.workflow_name).replace(/'/g, \"''\") + \"'\") : 'NULL' }},\n  {{ $json.execution_id ? (\"'\" + String($json.execution_id).replace(/'/g, \"''\") + \"'\") : 'NULL' }},\n  {{ $json.failed_node ? (\"'\" + String($json.failed_node).replace(/'/g, \"''\") + \"'\") : 'NULL' }},\n  {{ $json.error_message ? (\"'\" + String($json.error_message).replace(/'/g, \"''\") + \"'\") : 'NULL' }},\n  {{ $json.error_stack ? (\"'\" + String($json.error_stack).replace(/'/g, \"''\") + \"'\") : 'NULL' }},\n  {{ $json.channel ? (\"'\" + String($json.channel).replace(/'/g, \"''\") + \"'\") : 'NULL' }},\n  {{ $json.session_id ? (\"'\" + String($json.session_id).replace(/'/g, \"''\") + \"'\") : 'NULL' }},\n  {{ $json.user_phone ? (\"'\" + String($json.user_phone).replace(/'/g, \"''\") + \"'\") : 'NULL' }},\n  '{{ JSON.stringify($json.raw_payload || {}) }}'::jsonb,\n  NOW()\n)\nRETURNING id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -40,
        80
      ],
      "id": "55470e38-eb31-47d8-9870-errdblog001",
      "name": "DB - Log Workflow Error",
      "credentials": {
        "postgres": {
          "id": "yNVFJmXSqNtKGgso",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "err-if-wa",
              "leftValue": "={{ $json.channel || \"\" }}",
              "rightValue": "whatsapp",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
