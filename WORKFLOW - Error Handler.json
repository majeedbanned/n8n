              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{ ($json.user_phone || \"\").replace(\"+\", \"\") }}\",\"type\":\"text\",\"text\":{\"body\":\"{{ $json.fallback_message }}\"}}",
        "options": {
