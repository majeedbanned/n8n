{
  "name": "TOOL - Account Summary",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "user_id",
              "type": "number"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-400, 300],
      "id": "tool-trigger",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "// Normalize and validate input\nconst input = $input.first().json || {};\n\nconst user_id = Number(\n  input.user?.id ??\n  input.user_id ??\n  input.userId ??\n  input.client_id ??\n  input.clientId ??\n  null\n);\n\nif (!user_id || !Number.isFinite(user_id)) {\n  return [{\n    ok: false,\n    error: 'Missing or invalid user.id. Please authenticate the user first.',\n    tool: 'get_account_summary'\n  }];\n}\n\nreturn [{ user_id }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-200, 300],
      "id": "normalize-input",
      "name": "Normalize Input"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.ok}}",
              "value2": false
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [0, 300],
      "id": "check-error",
      "name": "IF - Input Error?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://mycms.cmsprime.com/rest/accounts?version=1.0.0",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "accept",
              "value": "application/json"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer 805e6648071ff54087a78d1f5e0a5508a3ed4fd92f692c704b4e3120991fcf3df3d2eab8d57ffb782d6e4d4fba12648fb04cc76c807ff684c96e5d24"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"userId\": $json.user_id } }}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [200, 200],
      "id": "api-get-accounts",
      "name": "API - Get Accounts"
    },
    {
      "parameters": {
        "jsCode": "// Format account summary response\nconst rows = $input.all().map(i => i.json).filter(Boolean);\nconst userId = $('Normalize Input').item.json.user_id;\n\nif (!rows || rows.length === 0) {\n  return [{\n    ok: false,\n    error: 'No trading accounts found for this user.',\n    tool: 'get_account_summary'\n  }];\n}\n\nconst serverTypeMap = {\n  5: 'MT4 Live',\n  2: 'MT5 Live',\n  1: 'Wallet',\n  4: 'MT4 Demo',\n  3: 'MT5 Demo'\n};\n\n// Keep only fields required by the assistant\nconst accounts = rows.map(acc => {\n  const sid = Number(acc.serverId ?? 0);\n  return {\n    login: String(acc.login ?? ''),\n    leverage: Number(acc.leverage ?? 0),\n    balance: Number(acc.balance ?? 0),\n    equity: Number(acc.equity ?? 0),\n    accountTypeId: acc.accountTypeId ?? null,\n    serverId: sid || null,\n    accounttype: serverTypeMap[sid] || 'Unknown'\n  };\n});\n\nreturn [{\n  ok: true,\n  user_id: userId,\n  accounts_count: accounts.length,\n  accounts\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 200],
      "id": "format-output",
      "name": "Format Account Summary"
    }
  ],
  "pinData": {},
  "connections": {
    "When Executed by Another Workflow": {
